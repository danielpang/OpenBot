#!/command/with-contenv bash
# shellcheck shell=bash
# Redis for the queues, the event bus and the rate limits, on /data/redis
# with an append-only file, bound to loopback and asking for
# OPENBOTS_REDIS_PASSWORD: the Bots' shells share this loopback. The password
# goes in a config file only the redis user reads, not on the command line.
set -euo pipefail
# shellcheck source=SCRIPTDIR/../../lib/env.sh
. /usr/local/lib/openbots/standalone/env.sh
openbots_load_env
install -d -m 0700 -o redis -g redis /run/redis
(
  umask 077
  cat >/run/redis/redis.conf <<CONF
bind 127.0.0.1
port 6379
protected-mode yes
dir /data/redis
appendonly yes
daemonize no
requirepass "${OPENBOTS_REDIS_PASSWORD}"
CONF
)
chown redis:redis /run/redis/redis.conf
exec env -i PATH=/command:/usr/bin:/bin LANG=C.UTF-8 \
  s6-notifyoncheck -d -3 3 -n 0 -s 500 -w 500 -c /usr/local/lib/openbots/standalone/check-redis \
  s6-setuidgid redis redis-server /run/redis/redis.conf
