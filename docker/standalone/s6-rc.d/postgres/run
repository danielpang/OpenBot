#!/bin/bash
# PostgreSQL 16 with pgvector, on /data/pgdata. It listens on loopback only
# (postgres.js, the server's driver, takes no socket path from DATABASE_URL)
# and on the socket in /run/postgresql, which only root and the postgres user
# may open. pg_hba.conf (standalone-init) asks every TCP client for a password.
# Ready once pg_isready answers; SIGINT (down-signal) is a fast shutdown.
set -euo pipefail
install -d -m 0700 -o postgres -g postgres /run/postgresql
exec env -i PATH=/usr/lib/postgresql/16/bin:/command:/usr/bin:/bin LANG=C.UTF-8 TZ=UTC \
  s6-notifyoncheck -d -3 3 -n 0 -s 1000 -w 1000 \
  -c "s6-setuidgid postgres pg_isready -q -h /run/postgresql -d postgres" \
  s6-setuidgid postgres \
  postgres -D /data/pgdata \
  -c listen_addresses=127.0.0.1 -c port=5432 \
  -c unix_socket_directories=/run/postgresql -c unix_socket_permissions=0700
