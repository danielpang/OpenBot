{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "customConditions": ["@openbots/source"],
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["react", "node"]
  },
  "include": ["app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx", "app.config.ts", "app/**/*.ts"],
  "exclude": ["node_modules", "ios", "android"]
}
