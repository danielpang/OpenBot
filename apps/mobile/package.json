{
  "name": "@openbots/mobile",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "main": "index.js",
  "scripts": {
    "dev": "node --dns-result-order=ipv4first node_modules/expo/bin/cli start --dev-client",
    "ios": "node --dns-result-order=ipv4first node_modules/expo/bin/cli run:ios",
    "ios:release": "node scripts/build-preview.mjs && expo run:ios --configuration Release",
    "prebuild": "expo prebuild --platform ios",
    "build": "node scripts/build-preview.mjs && expo export --platform ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src plugins app.config.ts",
    "test": "vitest run && jest --runInBand",
    "check:sdk": "expo install --check",
    "build:preview": "node scripts/build-preview.mjs",
    "test:components": "jest --runInBand"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@openbots/api-client": "workspace:*",
    "@openbots/avatars": "workspace:*",
    "@openbots/shared": "workspace:*",
    "@openbots/tunnel": "workspace:*",
    "@openbots/widgets": "workspace:*",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "catalog:",
    "expo": "~55.0.0",
    "expo-build-properties": "~55.0.18",
    "expo-camera": "~55.0.23",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.41",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.24",
    "expo-linking": "~55.0.17",
    "expo-local-authentication": "~55.0.18",
    "expo-modules-core": "~55.0.27",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.25",
    "expo-splash-screen": "~55.0.25",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "expo-updates": "~55.0.33",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "zod": "catalog:",
    "@noble/ciphers": "catalog:",
    "react-dom": "19.2.0",
    "@expo/plist": "^0.5.3",
    "@novnc/novnc": "^1.7.0",
    "@babel/runtime": "^7.29.7"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~55.0.0",
    "eslint": "catalog:",
    "typescript": "~5.9.2",
    "vitest": "catalog:",
    "@types/react-dom": "~19.2.0",
    "esbuild": "^0.27.0",
    "jest": "^29.7.0",
