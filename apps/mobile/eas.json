{
  "cli": { "version": ">= 18.0.0", "appVersionSource": "local" },
  "build": {
    "base": {
      "node": "22.23.4",
      "pnpm": "12.11.2"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "OPENBOTS_APNS_ENVIRONMENT": "development" }
    },
    "simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "simulator-release": {
      "extends": "base",
      "developmentClient": false,
      "distribution": "internal",
      "ios": { "simulator": true, "buildConfiguration": "Release" }
    },
    "preview": {
      "extends": "base",
      "developmentClient": false,
      "distribution": "store",
      "channel": "preview",
      "env": { "OPENBOTS_APNS_ENVIRONMENT": "production" }
    },
    "production": {
      "extends": "base",
      "developmentClient": false,
      "distribution": "store",
      "channel": "production",
      "env": { "OPENBOTS_APNS_ENVIRONMENT": "production" }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascApiKeyPath": "$EXPO_ASC_API_KEY_PATH",
        "ascApiKeyId": "$EXPO_ASC_KEY_ID",
        "ascApiKeyIssuerId": "$EXPO_ASC_ISSUER_ID",
        "ascAppId": "$OPENBOTS_ASC_APP_ID"
      }
    },
    "preview": { "extends": "production" }
  }
}
