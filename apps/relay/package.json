{
  "name": "@openbots/relay",
  "version": "0.0.0",
  "private": true,
  "description": "The private relay: host links, client streams and the APNs gateway (docs/RELAY_PROTOCOL.md)",
  "license": "BUSL-1.1",
  "type": "module",
  "exports": {
    ".": {
      "@openbots/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx watch --conditions=@openbots/source src/main.ts"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@noble/curves": "catalog:",
    "@noble/hashes": "catalog:",
    "hono": "catalog:",
    "ioredis": "catalog:",
    "pino": "catalog:",
    "prom-client": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
