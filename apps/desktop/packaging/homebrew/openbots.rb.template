# Homebrew cask for the OpenBots Mac app. The release workflow (release-mac.yml) renders
# this template ({{VERSION}}, {{SHA256}}, and {{REPOSITORY}}, the GitHub
# repository the release is published to) and attaches openbots.rb to the GitHub
# Release; copy it into the tap's Casks/ directory to publish.
cask "openbots" do
  version "{{VERSION}}"
  sha256 "{{SHA256}}"

  url "https://github.com/{{REPOSITORY}}/releases/download/v#{version}/OpenBots-#{version}-universal.dmg",
      verified: "github.com/{{REPOSITORY}}/"
  name "OpenBots"
  desc "Delegate work to AI Bots that chat, use tools and run their own computers"
  homepage "https://github.com/{{REPOSITORY}}"

  livecheck do
    url :url
    regex(/^v(\d+(?:\.\d+)+)$/i)
    strategy :github_latest
  end

  auto_updates true
  depends_on macos: ">= :monterey"

  app "OpenBots.app"

  zap trash: [
    "~/Library/Application Support/OpenBots",
    "~/Library/Logs/OpenBots",
    "~/Library/Preferences/com.openbots.app.plist",
    "~/Library/Saved Application State/com.openbots.app.savedState",
  ]
end
